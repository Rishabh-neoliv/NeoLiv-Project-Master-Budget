# Copy to .env.local and fill in. Never commit .env.local; add the same values in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# secret key: server only, never in the browser or in chat
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# the app's own address, used in email links (http://localhost:3000 locally, your Vercel URL when deployed)
APP_URL=http://localhost:3000

# Email through Microsoft 365 (preferred): values from IT (docs/IT request - Microsoft 365 email.md).
# MS_CLIENT_SECRET is secret: only here and in Vercel's settings, never in chat or git.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAIL_FROM=budget@neoliv.in

# Resend (alternative to Microsoft 365) → API Keys. Leave both empty to turn emails off (logged as "skipped").
RESEND_API_KEY=
# Resend's test sender only delivers to your own Resend account's email; use a verified domain for others.
EMAIL_FROM=NeoLiv Budget <onboarding@resend.dev>

# password for the dummy users that scripts/setup.mjs creates (8+ characters). Only needed locally.
SEED_PASSWORD=

# Anthropic (Claude) API key, for reading uploaded documents with AI: console.anthropic.com -> API Keys.
# Leave empty and the Files tab still works; only "Read with AI" is unavailable.
ANTHROPIC_API_KEY=

# Email through a Power Automate flow in your own Outlook (docs/Email via Power Automate.md). A long random secret
# (48+ characters); the flow reads https://<app address>/api/email-feed/<this secret>. Set it when the app is
# online: the flow can't reach localhost.
POWER_AUTOMATE_FEED_TOKEN=
